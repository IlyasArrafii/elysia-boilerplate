{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "logs:setup": "bun --env-file=../../.env scripts/logs-setup.ts",
    "logs:prune": "bun --env-file=../../.env scripts/logs-prune.ts",
    "test": "bun test tests/modules tests/utils tests/scripts tests/helpers",
    "test:e2e": "bun test tests/e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "better-auth": "1.7.15",
    "elysia": "1.4.30",
    "mongodb": "7.8.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "pino-pretty": "13.2.0"
  }
}
