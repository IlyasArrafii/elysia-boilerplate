# Copy to .env at the repo root and adjust. .env is git-ignored; this file holds placeholders only,
# never real secrets. Every variable of docs/implement-boilerplate/static-role/ARCHITECTURE.md §7 is
# listed here.
#
# The service URLs below match docker-compose.yml (`docker compose up -d`). Those credentials are
# throwaway local values; production uses its own, set in the deployment environment.
#
# Loading: this root .env is the only env file; never create one inside an app or package. Docker compose
# reads it by itself. The dev scripts pass it explicitly (Bun only auto-loads .env from the folder a script
# runs in, which is apps/api or packages/db, not the repo root): `bun --env-file=../../.env` for apps/api
# and the packages/db scripts (db:generate, db:migrate, db:seed), Vite's loadEnv for apps/web. A variable
# set in the shell wins over the same key here, and a missing .env file is fine (production and CI set
# real environment variables).

# --- Runtime ----------------------------------------------------------------------------------------

# development | test | production. Required: the API refuses to start when it is unset or anything else.
# There is no default, because development mode logs password-reset links and skips the production checks.
NODE_ENV=development

# Never set TEST in a deployment. Better Auth treats any non-empty TEST as test mode and turns off its
# origin and CSRF checks, so the API refuses to start with NODE_ENV=production and TEST set.

# API port (default 3000). The web dev server ignores PORT: it is fixed at 3001 (strictPort) in
# apps/web/vite.config.ts. The production web server does read PORT.
#
# GOTCHA: changing PORT moves the API, but the web dev proxy (apps/web/vite.config.ts, which reads
# API_INTERNAL_URL) keeps targeting :3000 until API_INTERNAL_URL changes too.
# Set both together, e.g. PORT=4000 and API_INTERNAL_URL=http://localhost:4000.
PORT=3000
API_INTERNAL_URL=http://localhost:3000

# Public web origin (one origin for web and API, DEC-020). BETTER_AUTH_URL is the base for the Google
# redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google. WEB_URL feeds Better Auth's trustedOrigins.
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3001

# Reverse proxies in front of the API: a comma-separated list of IP addresses or CIDR ranges, each
# validated at startup. Required when NODE_ENV=production, optional (empty) in development and test.
# Example for a single nginx on the same host: TRUSTED_PROXIES=127.0.0.1/32
# Why it matters: without trusted proxies, Better Auth accepts x-forwarded-for only when it holds a single
# IP. A proxy that appends to the header makes it a list, and Better Auth then puts every client in one
# shared `no-trusted-ip` rate-limit bucket, so one client can lock everyone out of sign-in.
TRUSTED_PROXIES=

# --- Authentication ---------------------------------------------------------------------------------

# At least 32 characters. Generate with: openssl rand -base64 32
# Left empty on purpose, so a forgotten secret fails fast instead of running with a known value.
BETTER_AUTH_SECRET=

# Google OAuth client, created in Google Cloud Console (APIs & Services > Credentials).
# Both or neither. Empty turns Google sign-in off, which only development and test allow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Super admin created by the dev seed script only. Pick a password; there is deliberately no default.
SEED_SUPER_ADMIN_EMAIL=admin@example.test
SEED_SUPER_ADMIN_PASSWORD=

# --- Data stores ------------------------------------------------------------------------------------

# PostgreSQL 17: all app data (Drizzle).
DATABASE_URL=postgres://app:app_dev@127.0.0.1:5432/app

# Redis 7: sessions, rate limits and module cache. Empty = in-memory fallback (dev and test only);
# production refuses to start without it.
REDIS_URL=redis://127.0.0.1:6379

# MongoDB 8: log store only. Empty LOG_MONGO_URL turns the mongo sink off (stdout only).
# LOG_MONGO_URL is the insert-only writer, used by the API process.
# LOG_MONGO_ADMIN_URL is the admin user for `logs:setup` / `logs:prune`; the API process never reads it.
# The database in each URL (and authSource) is where the users are defined; the driver uses LOG_MONGO_DB.
LOG_MONGO_URL=mongodb://log_writer:log_writer_dev@127.0.0.1:27017/app_logs?authSource=app_logs
LOG_MONGO_ADMIN_URL=mongodb://log_admin:log_admin_dev@127.0.0.1:27017/app_logs?authSource=app_logs
LOG_MONGO_DB=app_logs
# Lines at this level and above reach MongoDB (debug stays on stdout).
LOG_MONGO_MIN_LEVEL=info

# --- Logging and release ----------------------------------------------------------------------------

# Default info; debug is useful in development.
LOG_LEVEL=debug
# Added to the app.started event. Set by CI; leave empty locally.
APP_VERSION=

# --- Module settings --------------------------------------------------------------------------------

# Seconds. Empty means the default, 60.
POSTS_CACHE_TTL=
# Required, no default: the product owner sets the post length limits per deployment. The API does
# not start until both are set (title at least 3, content at least 10).
POSTS_TITLE_MAX_LENGTH=
POSTS_CONTENT_MAX_LENGTH=

# --- Docker Compose only (not read by the apps) -----------------------------------------------------

# Host ports published by docker-compose.yml. Change one when the default is taken on your machine
# (for example a local PostgreSQL on 5432), and change the matching URL above to the same port.
# docker-compose.test.yml uses fixed ports (5442, 6389, 27027) and ignores these.
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017
