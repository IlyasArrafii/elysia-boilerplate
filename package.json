{
  "name": "boilerplate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun --no-env-file scripts/setup.ts",
    "doctor": "bun --no-env-file scripts/doctor.ts",
    "infra:up": "docker compose -f docker-compose.yml up -d --build --wait",
    "infra:down": "docker compose -f docker-compose.yml down",
    "infra:status": "docker compose -f docker-compose.yml ps",
    "infra:logs": "docker compose -f docker-compose.yml logs -f",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch --env-file=.env apps/api/src/index.ts",
    "dev:web": "bun run --filter @repo/web dev",
    "build": "bun run --filter @repo/web build",
    "start": "bun run --parallel start:api start:web",
    "start:api": "bun --env-file=.env apps/api/src/index.ts",
    "start:web": "bun run --filter @repo/web start",
    "auth:generate": "bun run --filter @repo/db auth:generate",
    "db:generate": "bun run --filter @repo/db db:generate",
    "db:migrate": "bun run --filter @repo/db db:migrate",
    "db:seed": "bun run --filter @repo/db db:seed",
    "db:studio": "bun run --filter @repo/db db:studio",
    "role:set": "bun --env-file=.env apps/api/scripts/role-set.ts",
    "lint": "bun run --filter '@repo/web' lint",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck && tsc --noEmit -p scripts",
    "test": "bun test ./scripts && bun run --filter './apps/*' test",
    "test:e2e": "bun run --filter @repo/api test:e2e",
    "check:test-folders": "bun scripts/check-test-folders.ts",
    "check": "bun scripts/check.ts",
    "test:stack:up": "docker compose -f docker-compose.test.yml -p app-test up -d --build --wait",
    "test:stack:down": "docker compose -f docker-compose.test.yml -p app-test down -v"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
